# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit real values.
# With these empty, the checkout runs in DEMO mode (simulated payments).
# ─────────────────────────────────────────────────────────────────────────────

# Razorpay API keys — Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys first; switch to rzp_live_… only when ready to accept money.
# The secret is only read on the server (src/lib/payments/razorpay-server.ts).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — Dashboard → Webhooks. Endpoint: /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
